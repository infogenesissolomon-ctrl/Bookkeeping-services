{
  "redirects": [
    { "source": "/pages/process", "destination": "/#work-process", "permanent": true },
    { "source": "/pages/process/:path*", "destination": "/#work-process", "permanent": true },
    { "source": "/pages/industries", "destination": "/pages/about/#industries", "permanent": true },
    { "source": "/pages/industries/:path*", "destination": "/pages/about/#industries", "permanent": true },
    { "source": "/pages/tools", "destination": "/pages/about/#tools", "permanent": true },
    { "source": "/pages/tools/:path*", "destination": "/pages/about/#tools", "permanent": true },
    { "source": "/pages/values", "destination": "/#professional-values", "permanent": true },
    { "source": "/pages/values/:path*", "destination": "/#professional-values", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
