# Copy to .env.local for local testing with `vercel dev`, and add the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → API (or Data API): the project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (starts with sb_publishable_), or the legacy "anon" key. Safe for the browser;
# the admin page receives it from /api/admin-config. Row level security protects the data.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Secret key (starts with sb_secret_), or the legacy "service_role" key. Server only:
# used by /api/inquiries to save submissions. Never expose it in browser code.
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# ---- Email (Gmail) ----
# Notifications of new inquiries and replies to clients are sent through this Gmail account.
# GMAIL_APP_PASSWORD is a 16-character Google "App password" (Google Account → Security → 2-Step Verification →
# App passwords), not your normal Gmail password. Server only; never expose it in browser code.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Where new-inquiry notifications go. Defaults to GMAIL_USER.
ADMIN_NOTIFICATION_EMAIL=you@gmail.com

# Optional. The sender name clients see (default "Genesis Solomon"), and the site address used for the
# "View in Admin Dashboard" link (defaults to the Vercel production URL).
EMAIL_FROM_NAME=Genesis Solomon
SITE_URL=https://your-site.vercel.app

# ---- Website chat assistant (Gemini API) ----
# Create a key in Google AI Studio (https://aistudio.google.com/apikey). Server only: read by /api/chat, never sent
# to the browser. The free tier needs no billing; Google may use free-tier prompts to improve its products.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-3.5-flash-lite. Run `node scripts/check-gemini-model.js` to confirm availability.
GEMINI_MODEL=gemini-3.5-flash-lite
